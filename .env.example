# AI-Web-Scraper environment configuration.
# Copy to .env and fill in secrets. Variables are read ONLY in app/config.py.
# Every variable below maps to a Settings field (see context/code-standards.md).

# --- LLM provider selection ---
LLM_PROVIDER=anthropic

# --- Anthropic (default provider) ---
# Required when LLM_PROVIDER=anthropic. Leave blank here; set the real key in .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (optional second provider) ---
# Required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- LLM call ---
LLM_TIMEOUT_SECONDS=60

# --- Fetch (HTTP fast path) ---
FETCH_TIMEOUT_SECONDS=15
MAX_REDIRECTS=5
FETCH_MAX_RETRIES=1
MAX_RESPONSE_BYTES=5000000
# Set true ONLY to fetch localhost/LAN in tests; disables the SSRF private-IP block.
ALLOW_PRIVATE_HOSTS=false
USER_AGENT=AI-Web-Scraper/0.1

# --- Render (browser fallback, opt-in via render=true) ---
RENDER_TIMEOUT_SECONDS=30
RENDER_SETTLE_MS=500

# --- Cleaning ---
# Coarse character cap before the LLM (NOT a token count). Provisional default;
# finalized as the Settings default in Feature 02.
MAX_CONTENT_CHARS=50000

# --- Respectful client ---
RESPECT_ROBOTS=true
RATE_LIMIT_PER_HOST_PER_MINUTE=30

# --- Jobs (must satisfy MAX_CONCURRENT_JOBS <= MAX_QUEUED_JOBS <= MAX_JOBS) ---
MAX_CONCURRENT_JOBS=4
MAX_QUEUED_JOBS=50
MAX_JOBS=500
SHUTDOWN_GRACE_SECONDS=10
JOB_TTL_SECONDS=3600

# --- Server / host (HOST/PORT honored only via `python -m app`) ---
ALLOWED_HOSTS=127.0.0.1,localhost
HOST=127.0.0.1
PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
